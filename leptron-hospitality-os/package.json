{
  "name": "leptron-hospitality-os",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@leptron/api",
    "dev:web": "npm run dev --workspace=@leptron/web",
    "build": "npm run build --workspaces",
    "build:api": "npm run build --workspace=@leptron/api",
    "build:web": "npm run build --workspace=@leptron/web",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "db:migrate": "npm run migrate --workspace=@leptron/database",
    "db:generate": "npm run generate --workspace=@leptron/database",
    "db:studio": "npm run studio --workspace=@leptron/database",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
